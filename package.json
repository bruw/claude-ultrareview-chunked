{
  "name": "claude-ultrareview-chunked",
  "version": "0.3.0",
  "description": "Chunked ultrareview: slice a whole codebase into diff-sized pieces and run a Claude Code ultrareview over each one.",
  "keywords": [
    "claude",
    "claude-code",
    "ultrareview",
    "code-review",
    "git",
    "cli"
  ],
  "homepage": "https://github.com/bruw/curc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bruw/curc.git"
  },
  "license": "MIT",
  "author": {
    "name": "bruw"
  },
  "type": "module",
  "bin": {
    "curc": "bin/curc.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-timeout 180000 test/*.test.js",
    "lint": "standard src bin test",
    "lint:fix": "standard --fix src bin test",
    "prepublishOnly": "npm run lint && npm test"
  },
  "devDependencies": {
    "standard": "^17.1.2"
  }
}
